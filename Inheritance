#Single inheritance
class Car():

    color = "black"

    @staticmethod
    def start():
        print("car started")

    @staticmethod
    def stop():
        print("car stopped")

class Brand(Car):

    def __init__(self,brand):
        super().__init__()
        self.brand = brand

c1 = Brand("Suzuki")
c2 = Car()

print(c2.color)
print(c1.color)
c1.start()

#Multi Level Inheritance

class Alto(Brand):

    cc = 600

    def __init__(self,variant):
        super().__init__(brand="Suzuki")
        self.variant = variant

c3 = Alto("VXR")
print(c3.brand)
print(c3.color)
print(c3.cc)


        